# Folder targets.

# =============================================================================

#############################################
# Folder: /workspace/build-gui

build all: phony vendor_ext/all src/all Examples/all tools/smoke_test/all

# =============================================================================

#############################################
# Folder: /workspace/build-gui/Examples

build Examples/all: phony bin/Monocular/mono_euroc bin/Monocular/mono_kitti bin/Monocular/mono_tum bin/Monocular/mono_tum_vi bin/Monocular-Inertial/mono_inertial_euroc bin/Monocular-Inertial/mono_inertial_tum_vi bin/Stereo/stereo_euroc bin/Stereo/stereo_kitti bin/Stereo/stereo_tum_vi bin/Stereo-Inertial/stereo_inertial_euroc bin/Stereo-Inertial/stereo_inertial_tum_vi bin/RGB-D/rgbd_tum

# =============================================================================

