  POST_BUILD = :
  PRE_LINK = :
  TARGET_FILE = tools/smoke_test/smoke_test
  TARGET_PDB = smoke_test.dbg


#############################################
# Utility command for test

build tools/smoke_test/CMakeFiles/test.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build-gui/tools/smoke_test && /usr/bin/ctest --force-new-ctest-process
  DESC = Running tests...
  pool = console
  restat = 1

build tools/smoke_test/test: phony tools/smoke_test/CMakeFiles/test.util


#############################################
# Utility command for edit_cache

build tools/smoke_test/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build-gui/tools/smoke_test && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

build tools/smoke_test/edit_cache: phony tools/smoke_test/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build tools/smoke_test/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build-gui/tools/smoke_test && /usr/bin/cmake --regenerate-during-build -S/workspace -B/workspace/build-gui
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build tools/smoke_test/rebuild_cache: phony tools/smoke_test/CMakeFiles/rebuild_cache.util

# =============================================================================
# Target aliases.

build ORB_SLAM3: phony lib/libORB_SLAM3.so

build libORB_SLAM3.so: phony lib/libORB_SLAM3.so

build mono_euroc: phony bin/Monocular/mono_euroc

build mono_inertial_euroc: phony bin/Monocular-Inertial/mono_inertial_euroc

build mono_inertial_tum_vi: phony bin/Monocular-Inertial/mono_inertial_tum_vi

build mono_kitti: phony bin/Monocular/mono_kitti

build mono_tum: phony bin/Monocular/mono_tum

build mono_tum_vi: phony bin/Monocular/mono_tum_vi

build rgbd_tum: phony bin/RGB-D/rgbd_tum

build smoke_test: phony tools/smoke_test/smoke_test

build stereo_euroc: phony bin/Stereo/stereo_euroc

build stereo_inertial_euroc: phony bin/Stereo-Inertial/stereo_inertial_euroc

build stereo_inertial_tum_vi: phony bin/Stereo-Inertial/stereo_inertial_tum_vi

build stereo_kitti: phony bin/Stereo/stereo_kitti

build stereo_tum_vi: phony bin/Stereo/stereo_tum_vi

