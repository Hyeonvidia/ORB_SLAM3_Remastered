#############################################
# Phony target to force glob verification run.

build /workspace/build-gui/CMakeFiles/VerifyGlobs.cmake_force: phony


#############################################
# Re-run CMake to check if globbed directories changed.

build /workspace/build-gui/CMakeFiles/cmake.verify_globs: VERIFY_GLOBS | /workspace/build-gui/CMakeFiles/VerifyGlobs.cmake_force
  pool = console
  restat = 1


