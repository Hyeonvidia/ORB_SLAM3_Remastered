build src/all: phony lib/libORB_SLAM3.so

# =============================================================================

#############################################
# Folder: /workspace/build-gui/tools/smoke_test

build tools/smoke_test/all: phony tools/smoke_test/smoke_test

# =============================================================================

#############################################
# Folder: /workspace/build-gui/vendor_ext

build vendor_ext/all: phony vendor_ext/dbow2_ext/all vendor_ext/g2o_ext/all

