# Not ours to format.
#
# reference/ORB_SLAM3 is pristine ORB-SLAM3 v1.0, the baseline every
# "what did we change" answer is measured against. Reformatting it would
# silently rewrite that answer.
#
# clang-format searches parent directories, so without this the repo-root
# .clang-format would reach in here — including from an editor that formats on
# save. DisableFormat also suppresses include sorting in 18.1.3, but SortIncludes
# is pinned beside it because that coupling has changed between releases.
#
# This file lives in the parent directory, which belongs to the main repository.
# Putting it inside a submodule would dirty that submodule and be destroyed by
# `git submodule update`.
DisableFormat: true
SortIncludes: Never
