# Revisions to skip when running git blame.
#
# Enable it once per clone:
#
#     git config blame.ignoreRevsFile .git-blame-ignore-revs
#
# It is not automatic: blame.ignoreRevsFile is local config, so a fresh clone
# ignores this file until that command is run.
#
# Only whole-tree, no-logic commits belong here. Each entry must be a full
# 40-character SHA.

