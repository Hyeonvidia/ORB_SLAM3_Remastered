# =============================================================================
# orbslam3r/dev  —  interactive development / algorithm-test container
#
# Layer 3 of 3.  Adds debugging tools and the runtime entrypoint on top of the
# dependency layer.  The project source is NOT baked in: it is bind-mounted at
# /workspace so an edit on the host is visible in the container immediately.
#
#   base  ->  thirdparty  ->  dev
# =============================================================================
ARG THIRDPARTY_IMAGE=orbslam3r/thirdparty:24.04
FROM ${THIRDPARTY_IMAGE}

LABEL org.opencontainers.image.title="orbslam3r-dev"
LABEL org.opencontainers.image.description="Interactive dev/test container for ORB_SLAM3_Remastered"

ENV DEBIAN_FRONTEND=noninteractive

# xdotool is here for GUI verification: with no window manager running under
# Xvfb, every toolkit places its window at +0+0, so screenshots of one window
# capture whatever is stacked on top of it. Moving and raising windows is the
# only way to capture them cleanly.
#
# Xephyr is a nested X server: it gives Mesa a local framebuffer to render into
# -- where MIT-SHM works, because it is the same kernel -- and repaints its own
# window on the outer X server with ordinary drawing requests. That is the one
# transport that could put the viewer on a macOS desktop directly, since Mesa
# presenting straight to XQuartz fails its per-frame shm attach.
#
# x11vnc exports the Xvfb screen over VNC. That is how the viewer is watched
# live from macOS: XQuartz cannot host it (its indirect GLX offers only OpenGL
# 1.4, and Pangolin finds no usable fbConfig), but macOS ships a VNC client, so
# rendering stays in the container on llvmpipe and only pixels cross over.
#
# clang-format applies .clang-format at the repository root. It lives here, not
# on the host, for the same reason the compiler does: the formatting a file gets
# must not depend on which machine touched it, and clang-format's output changes
# between major versions.
RUN apt-get update && apt-get install -y --no-install-recommends \
        clang-format \
        gdb \
        less \
        vim-tiny \
        nano \
        tmux \
        htop \
        file \
        bash-completion \
        xdotool \
        x11vnc \
        xserver-xephyr \
    && rm -rf /var/lib/apt/lists/*

# ccache keeps incremental rebuilds of the SLAM library cheap across container
# restarts when /root/.ccache is mounted as a named volume.
ENV CCACHE_DIR=/root/.ccache
ENV CCACHE_MAXSIZE=5G

# Display strategy:
#   headless -> entrypoint starts Xvfb on :99 so Pangolin can be linked and
#               even run offscreen; the viewer is normally disabled instead.
#   x11      -> DISPLAY is supplied by the caller (XQuartz on macOS) and the
#               entrypoint leaves it alone.
ENV ORBSLAM3R_DISPLAY_MODE=headless
ENV XVFB_RESOLUTION=1600x1200x24

COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["/bin/bash"]
